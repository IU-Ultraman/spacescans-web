# git worktrees used during subagent-driven-development
.worktrees/

# Docker
# docker compose local config — created from .env.docker.example
.env
# user-supplied exposure data (several GB) — the big raw datasets are never
# committed. What IS committed: the layout README, the folder skeleton
# (.gitkeep), the FARA column-selection table, and the four deployer
# artifacts small enough to ship (NDI / Walkability / CBP+ZBP, ~145 MB raw,
# ~58 MB packed) so those variables work straight from a clone.
pipeline-data/**
!pipeline-data/**/
!pipeline-data/README.md
!pipeline-data/**/.gitkeep
!pipeline-data/FARA/C4/varnameCountRemoved.csv
!pipeline-data/TEMIS/C3/temis_template.tif
!pipeline-data/NDI/C4/ndi_bg_acs5_2008_2012_to_2020_2024_nationwide_summaryfile_xgboost.rds
!pipeline-data/Walkability/C4/epawalkind_nationwide_2016_2021.Rda
!pipeline-data/Community_Organization_Density/C4/cbp_nationwide_0519.Rda
!pipeline-data/Community_Organization_Density/C4/zbp_nationwide_0521.Rda

# internal working docs (plans/specs/preflight notes) — kept locally, not shipped
docs/superpowers/

# macOS Finder cruft — anywhere in the tree
.DS_Store
**/.DS_Store
