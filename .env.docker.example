# Copy to `.env` in this directory before `docker compose up`:
#     cp .env.docker.example .env
# docker compose reads it automatically for the variables below.

# JWT signing secret — set a real random value for anything beyond local testing.
SECRET_KEY=change-me-to-a-real-secret

# Origin the browser uses to reach the backend. Baked into the frontend bundle
# at build time. Keep as-is for the default two-port local setup; change it if
# you put a reverse proxy in front or expose the backend elsewhere.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Host path to the exposure-data root (must contain data_full/ and data/).
# Defaults to the in-repo ./pipeline-data folder — uncomment + set this only to
# reuse an existing data tree without copying (e.g. the parent repo).
# SPACESCANS_DATA_HOST=..
